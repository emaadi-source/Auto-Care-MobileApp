<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state (slightly tinted) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF3F5" /> <!-- very light maroon tint -->
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/light_gray" />
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/light_gray" />
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

</selector>
