<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming Call"
        android:textColor="@color/dark_brown"
        android:textSize="24sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="150dp"/>

    <ImageView
        android:id="@+id/btnAcceptCall"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_call"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="60dp"
        android:tint="@color/primary_maroon"
        android:layout_alignParentStart="true"
        android:contentDescription="Accept Call"/>

    <ImageView
        android:id="@+id/btnDeclineCall"
        android:layout_width="100dp"
        android:tint="@color/maroon"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="60dp"
        android:layout_alignParentEnd="true"
        android:contentDescription="Decline Call"/>

</RelativeLayout>
